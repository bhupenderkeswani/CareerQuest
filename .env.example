# Copy to .env.local and fill in. Vite only exposes variables that start with VITE_, and everything
# here ends up in the browser bundle, so ONLY put public values in this file.
#
# Supabase dashboard > Project Settings > API:
#   Project URL        -> VITE_SUPABASE_URL
#   anon / publishable -> VITE_SUPABASE_ANON_KEY   (the "anon" public key, or a publishable key)
#
# NEVER put the service_role / secret key here. The app refuses to use it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
